{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.ide/schemas/pulse.plugin.json",
  "title": "Pulse Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version", "publisher", "description", "engine", "entry"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "publisher": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "engine": { "type": "string" },
    "entry": { "type": "string" },
    "contributes": {
      "type": "object",
      "properties": {
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "ui"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "ui": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
